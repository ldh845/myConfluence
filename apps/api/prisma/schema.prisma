generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Space {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  pages       Page[]
}

model Page {
  id          String        @id @default(cuid())
  title       String
  content     String        @default("")
  // 이슈 2 (Cycle 10-1) — 편집 중 임시 저장.
  // null이면 draft 없음(published만). PATCH /pages/:id/draft로 갱신,
  // POST /pages/:id/publish로 비움(content로 승격).
  draftContent String?
  spaceId     String
  space       Space         @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  parentId    String?
  parent      Page?         @relation("PageTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    Page[]        @relation("PageTree")
  diagrams    Diagram[]
  versions    PageVersion[]
  attachments Attachment[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([spaceId])
  @@index([parentId])
}

model Attachment {
  id         String   @id @default(cuid())
  pageId     String
  page       Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  filename   String
  mimetype   String
  size       Int
  storageKey String   @unique
  authorName String?
  createdAt  DateTime @default(now())

  @@index([pageId])
}

model PageVersion {
  id         String   @id @default(cuid())
  pageId     String
  page       Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  title      String
  content    String
  authorName String?
  version    Int
  createdAt  DateTime @default(now())

  @@unique([pageId, version])
  @@index([pageId, createdAt])
}

model Diagram {
  id        String   @id @default(cuid())
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  title     String   @default("Untitled diagram")
  data      String   @default("")
  preview   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pageId])
}
