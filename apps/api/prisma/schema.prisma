generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// FR-001 / FR-002 (Cycle 27a) — 사용자 + 역할.
// 첫 가입자만 자동 ADMIN, 이후는 DEVELOPER. Role은 추후 ADMIN이 조정.
enum Role {
  ADMIN
  PART_LEADER
  DEVELOPER
  DESIGNER
  PM
}

model User {
  id               String      @id @default(cuid())
  username         String      @unique
  passwordHash     String
  name             String
  department       String
  role             Role        @default(DEVELOPER)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  authoredPages    Page[]      @relation("PageAuthor")
  editedPages      Page[]      @relation("PageEditor")
  // FR-001 / FR-002 (Cycle 27d) — Comment / PageShare 작성자 양방향 관계.
  // user 삭제 시 SetNull → authorName / 시스템 표기로 fallback.
  authoredComments Comment[]   @relation("CommentAuthor")
  createdShares    PageShare[] @relation("ShareCreator")
}

model Space {
  id           String        @id @default(cuid())
  name         String
  description  String?
  createdAt    DateTime      @default(now())
  pages        Page[]
  activityLogs ActivityLog[]
}

model Page {
  id           String        @id @default(cuid())
  title        String
  content      String        @default("")
  // 이슈 2 (Cycle 10-1) — 편집 중 임시 저장.
  // null이면 draft 없음(published만). PATCH /pages/:id/draft로 갱신,
  // POST /pages/:id/publish로 비움(content로 승격).
  draftContent String?
  spaceId      String
  space        Space         @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  parentId     String?
  parent       Page?         @relation("PageTree", fields: [parentId], references: [id], onDelete: Cascade)
  children     Page[]        @relation("PageTree")
  diagrams     Diagram[]
  versions     PageVersion[]
  attachments  Attachment[]
  comments     Comment[]
  shares       PageShare[]
  activityLogs ActivityLog[]
  reactions    Reaction[]
  // FR-024 (Cycle 18-1a) — 휴지통(soft delete). null이면 활성 페이지.
  // 모든 일반 조회는 deletedAt IS NULL 필터 적용. 영구 삭제는 별도 endpoint.
  deletedAt    DateTime?
  // FR-021 (Cycle 19a) — 사이드바 트리 정렬용. 같은 (spaceId, parentId) 그룹
  // 안에서 0,1,2,... 순서. reorder 시 한 그룹의 position을 일괄 재부여.
  position     Int           @default(0)
  // FR-001 (Cycle 27c) — 작성자 / 마지막 편집자. user 삭제 시 SetNull.
  authorId     String?
  author       User?         @relation("PageAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  lastEditorId String?
  lastEditor   User?         @relation("PageEditor", fields: [lastEditorId], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([spaceId])
  @@index([parentId])
  @@index([deletedAt])
  @@index([parentId, position], map: "Page_parent_position_idx")
  @@index([authorId])
  @@index([lastEditorId])
  // FR-090 (Cycle 15-1a / 17) — 한글 부분 일치 ILIKE 가속용 GIN trigram 인덱스.
  // schema에 명시함으로써 향후 prisma migrate가 자동 DROP하지 않도록 차단.
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "Page_title_trgm_idx")
  @@index([content(ops: raw("gin_trgm_ops"))], type: Gin, map: "Page_content_trgm_idx")
}

// FR-070 (Cycle 16-1a) — 페이지 댓글.
// parentId/parent self-relation은 16-2 스레드 사이클 대비. 현재는 모두 null.
// page cascade로 페이지 삭제 시 함께 정리. 권한 체크는 인증 사이클까지 보류.
// FR-131 (Cycle 24) — 활동 피드.
// page/space onDelete: SetNull — 영구 삭제 후에도 로그 보존(payload에 title 스냅샷).
// actorName은 인증 도입 전 단순 문자열(댓글의 authorName 등).
model ActivityLog {
  id        String   @id @default(cuid())
  type      String
  spaceId   String?
  space     Space?   @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  pageId    String?
  page      Page?    @relation(fields: [pageId], references: [id], onDelete: SetNull)
  actorName String?
  payload   Json?
  createdAt DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([spaceId, createdAt(sort: Desc)])
}

// FR-120 (Cycle 23) — 페이지 공유 링크.
// 토큰 보유자에게 읽기 전용 접근. revokedAt이 null이면 활성.
model PageShare {
  id          String    @id @default(cuid())
  pageId      String
  page        Page      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  token       String    @unique
  // FR-001 / FR-120 (Cycle 27d) — 발급자. user 삭제 시 SetNull.
  createdById String?
  createdBy   User?     @relation("ShareCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?

  @@index([pageId])
  @@index([createdById])
}

model Comment {
  id         String    @id @default(cuid())
  pageId     String
  page       Page      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  parentId   String?
  parent     Comment?  @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies    Comment[] @relation("CommentThread")
  // FR-001 / FR-070 (Cycle 27d) — 작성자 FK. user 삭제 시 SetNull → authorName fallback.
  authorId   String?
  author     User?     @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  authorName String?
  body       String
  // FR-071 (Cycle 16-3a) — 인라인 댓글.
  // isInline=true면 anchorJson에 ProseMirror 위치(from/to)와 선택 텍스트를 JSON
  // 문자열로 저장. resolvedAt/resolvedBy는 해결 시각·해결자.
  isInline   Boolean   @default(false)
  anchorJson String?
  resolvedAt DateTime?
  resolvedBy String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([pageId, createdAt])
  @@index([parentId])
  @@index([pageId, isInline, resolvedAt])
  @@index([authorId])
  reactions  Reaction[]
}

// FR-073 (Cycle 25) — 이모지 반응. page 또는 comment 둘 중 하나에 연결.
// 인증 도입 전엔 reactorId(브라우저 UUID)로 식별. 같은 reactor가 같은 대상에
// 같은 emoji 한 번만 (NULL 처리는 Postgres가 distinct로 보지만 service에서 가드).
model Reaction {
  id          String   @id @default(cuid())
  emoji       String
  reactorId   String
  reactorName String?
  pageId      String?
  page        Page?    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  commentId   String?
  comment     Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([pageId])
  @@index([commentId])
}

model Attachment {
  id         String   @id @default(cuid())
  pageId     String
  page       Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  filename   String
  mimetype   String
  size       Int
  storageKey String   @unique
  authorName String?
  createdAt  DateTime @default(now())

  @@index([pageId])
}

model PageVersion {
  id         String   @id @default(cuid())
  pageId     String
  page       Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  title      String
  content    String
  authorName String?
  version    Int
  createdAt  DateTime @default(now())

  @@unique([pageId, version])
  @@index([pageId, createdAt])
}

model Diagram {
  id        String   @id @default(cuid())
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  title     String   @default("Untitled diagram")
  data      String   @default("")
  preview   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pageId])
}
