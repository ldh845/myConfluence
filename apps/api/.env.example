DATABASE_URL="postgresql://docspace:docspace@localhost:5432/docspace?schema=public"

# Cycle 40 — NestJS가 listen 할 HTTP 포트.
# apps/web/.env 의 API_PORT(Next.js 프록시 타깃)와 반드시 같은 값이어야
# 한다. 다르면 회원가입/로그인 시 503 또는 ECONNREFUSED 발생.
# 코드 기본값은 3001 — 특별한 이유 없으면 그대로 두는 게 안전.
PORT=3001

# Cycle 39 — Hocuspocus 협업 서버의 Redis Pub/Sub 어댑터 (NFR-S-002) 토글.
# 단일 인스턴스(사내 PC, 단일 서버) 운영이면 false 유지 — Redis 없어도 메모리
# 모드로 정상 동작한다. 멀티 인스턴스로 수평 확장 시에만 true로 켜고 Redis
# 서버를 준비. (true / 1 / yes 모두 활성으로 인식)
USE_REDIS=false
REDIS_HOST=localhost
REDIS_PORT=6379

# 페이지당 보관할 버전 수. 초과분은 오래된 순으로 삭제 (FR-064).
PAGE_VERSION_RETENTION=50

# 첨부파일 저장 경로 (FR-080~083, SRS 3장 로컬 파일 시스템 1차).
# 상대경로일 때 NestJS process.cwd() (= apps/api) 기준.
ATTACHMENT_STORAGE_PATH=./storage/attachments
# 단일 파일 최대 크기 (MB). NFR-P-007 기준 100MB.
ATTACHMENT_MAX_SIZE_MB=100

# Cycle 43 — Keycloak OIDC(SSO) 실사용 값.
# AFS 입주 시엔 코드는 그대로 두고 이 값들만 AFS Keycloak 기준으로 교체.
# - KC_ISSUER_URI: realm 의 OIDC issuer. **discovery 요청 host 가 곧 토큰 iss 가
#   되므로, 브라우저·api·토큰이 모두 같은 host 를 보게 통일해야 한다.**
#   호스트 dev(api=호스트, keycloak=컨테이너 :8080 publish)에선 localhost 로 통일.
#   (api 가 컨테이너로 같은 네트워크에 있으면 http://keycloak:8080/... 사용)
KC_ISSUER_URI=http://localhost:8080/realms/docspace
KC_CLIENT_ID=docspace-web
KC_CLIENT_SECRET=dev-docspace-secret
# 콜백은 realm client redirect URI(localhost:3000/*)에 맞춰 Next 프록시 경유.
OIDC_REDIRECT_URI=http://localhost:3000/api/auth/oidc/callback
# 로그인 성공 후 이동할 앱 경로.
OIDC_POST_LOGIN_REDIRECT=/home
