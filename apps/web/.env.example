# DocSpace는 NestJS API와 동일한 PG를 사용한다.
# 백엔드 환경변수(DATABASE_URL 등)는 apps/api/.env 참고.

# Cycle 40 — Next.js → NestJS API 프록시 타깃 포트.
# apps/api/.env 의 PORT(NestJS가 실제로 listen하는 포트)와 반드시 같은
# 값이어야 한다. 미설정 시 next.config.mjs 의 기본값 3001 사용.
API_PORT=3001

# 공동 편집용 y-websocket 서버 주소 (선택)
# 설정하지 않으면 브라우저가 접속한 호스트의 :1234 로 자동 연결됩니다.
# 사내에서 고정 IP/도메인을 쓰려면 아래처럼 지정하세요.
# NEXT_PUBLIC_WS_URL="ws://10.0.0.5:1234"

# 다이어그램은 Excalidraw(순수 React 컴포넌트)를 사용하며
# 외부 호출이 필요 없습니다. 추가 환경변수 없음.
