# DocSpace는 NestJS API와 동일한 PG를 사용한다.
# 백엔드 환경변수(DATABASE_URL 등)는 apps/api/.env 참고.

# Cycle 40 — Next.js → NestJS API 프록시 타깃 포트.
# apps/api/.env 의 PORT(NestJS가 실제로 listen하는 포트)와 반드시 같은
# 값이어야 한다. 미설정 시 next.config.mjs 의 기본값 3001 사용.
API_PORT=3001

# 공동 편집용 y-websocket 서버 주소 (선택)
# 설정하지 않으면 브라우저가 접속한 호스트의 :1234 로 자동 연결됩니다.
# 사내에서 고정 IP/도메인을 쓰려면 아래처럼 지정하세요.
# NEXT_PUBLIC_WS_URL="ws://10.0.0.5:1234"

# 다이어그램은 Excalidraw(순수 React 컴포넌트)를 사용하며
# 외부 호출이 필요 없습니다. 추가 환경변수 없음.

# Cycle 42 — 컨테이너 빌드 시 web → api 프록시 호스트.
# 비컨테이너(npm run dev:all)에서는 미설정(기본 localhost) 그대로 둔다.
# 컨테이너에서는 Dockerfile 빌드 ARG 로 주입(compose: API_HOST=api). 포트는
# API_PORT 컨벤션(3001) 유지.
# API_HOST=api

# Cycle 42 — Keycloak OIDC 연동 값 (placeholder, Cycle 43부터 실사용).
# 로그인 페이지가 Keycloak authorization code flow 로 리다이렉트할 때 사용.
# 브라우저가 도달해야 하므로 issuer 는 외부 접속 주소 기준(Cycle 43에서 확정).
# NEXT_PUBLIC_KC_ISSUER_URI="http://166.79.31.248:8080/realms/docspace"
# NEXT_PUBLIC_KC_CLIENT_ID="docspace-web"

# K8s oauth2-proxy 환경에서 SSO 로그인 버튼이 이동할 URL.
# 미설정 시 기존 OIDC 경로(/api/auth/oidc/login) 사용.
# K8s(AFS)에서는 oauth2-proxy 표준 로그인 경로를 설정.
# NEXT_PUBLIC_OAUTH2_LOGIN_URL="/oauth2/start"

# Cycle 48 — 관리자 페이지의 'Keycloak Admin 콘솔' 링크 (사용자 관리 안내).
# 환경마다 다름. 로컬 dev: http://localhost:8080/admin/ ,
# VM: http://166.79.31.248:8082/auth/admin/ 등. 미설정 시 localhost dev 기본값.
# NEXT_PUBLIC_KC_ADMIN_URL="http://166.79.31.248:8082/auth/admin/"

# === 화면 테스트용 ADMIN 강제 우회 (dev 빌드 전용) ===
# .env.local 에 true 로 설정 시, useAuth().user.role 이 항상 "ADMIN" 으로 반환됨.
# 운영 빌드(NODE_ENV=production)에서는 tree-shaking으로 코드 자체가 제거되어 무효.
# 백엔드 RolesGuard는 영향 없음 — 실제 권한 없는 사용자가 데이터를 받을 순 없음.
# NEXT_PUBLIC_DEV_FORCE_ADMIN=true
