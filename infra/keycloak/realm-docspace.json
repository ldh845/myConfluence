{
  "realm": "docspace",
  "enabled": true,
  "displayName": "DocSpace (dev)",
  "loginWithEmailAllowed": true,
  "registrationAllowed": false,
  "sslRequired": "none",
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "DocSpace ADMIN 권한"
      }
    ]
  },
  "groups": [
    {
      "name": "dev-team1"
    },
    {
      "name": "dev-team2"
    }
  ],
  "clients": [
    {
      "clientId": "docspace-web",
      "name": "DocSpace Web (authorization code flow)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "dev-docspace-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/*",
        "http://166.79.31.248:3000/*",
        "http://166.79.31.248:8082/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://166.79.31.248:3000",
        "http://166.79.31.248:8082"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:3000/*##http://166.79.31.248:3000/*##http://166.79.31.248:8082/*"
      },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String"
          }
        },
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "claim.name": "groups"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "testuser",
      "enabled": true,
      "emailVerified": true,
      "email": "testuser@docspace.local",
      "firstName": "Test",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "testpass",
          "temporary": false
        }
      ],
      "groups": ["/dev-team1"]
    },
    {
      "username": "testuser2",
      "enabled": true,
      "emailVerified": true,
      "email": "testuser2@docspace.local",
      "firstName": "Test",
      "lastName": "User2",
      "credentials": [
        {
          "type": "password",
          "value": "test1234",
          "temporary": false
        }
      ],
      "groups": ["/dev-team1"]
    },
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "email": "admin@samsung.com",
      "firstName": "Admin",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": true
        }
      ],
      "realmRoles": ["admin"]
    }
  ]
}
