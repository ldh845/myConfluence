# Cycle 46 — EOL 정합. 모든 텍스트 파일은 저장소에 LF 로 저장한다.
# (Windows 작업 트리에선 git autocrlf 가 체크아웃 시 CRLF 로 바꿔도 무방 —
# 저장소 표준은 LF. 이로써 그동안 반복되던 CRLF/LF 유령 diff 가 해소된다.)
* text=auto eol=lf

# 셸 스크립트는 항상 LF (Linux 에서 실행).
*.sh text eol=lf

# 바이너리 — diff/merge 시도 안 함.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.pptx binary
*.docx binary
*.xlsx binary
*.zip binary
*.tar.gz binary
*.tgz binary
*.gz binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary
